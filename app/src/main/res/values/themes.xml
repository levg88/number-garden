<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.NumberGarden" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/cream</item>
        <item name="android:statusBarColor">@color/cream</item>
        <item name="android:navigationBarColor">@color/cream</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- Ignored below API 27; runtime SystemBarStyle handles the icon appearance. -->
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <!-- Ignored below API 29; the app is Compose-only and uses an explicit light scheme. -->
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
        <item name="android:colorAccent">@color/ink</item>
    </style>
</resources>
